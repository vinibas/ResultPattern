<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../LICENSE.txt" Pack="true" PackagePath="" />
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <PropertyGroup>
        <PackageId>ViniBas.ResultPattern</PackageId>
        <VersionPrefix>3.0.0-preview4</VersionPrefix>
        <Authors>Vinícius Bastos da Silva</Authors>
        <Description>Implements the Result Pattern for .NET — clean, flexible error handling without exceptions. Provides Result, Result&lt;T&gt;, Error, and ResultResponse types with no external dependencies.</Description>
        <Copyright>Copyright (c) Vinícius Bastos da Silva 2025-2026</Copyright>
        <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/vinibas/ResultPattern</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/vinibas/ResultPattern</RepositoryUrl>
        <PackageTags>ResultPattern;Result Pattern;Result;Notification;Notification Pattern;ViniBas</PackageTags>
        <PackageReleaseNotes>
            v3.0.0: Added Unauthorized and Forbidden error types; ResultResponseError now stores
            ErrorDetails instead of plain strings; added .NET 10 support; dropped .NET 7. Both
            packages now follow the same versioning.
        </PackageReleaseNotes>
    </PropertyGroup>
</Project>
